rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hanya koleksi yang app ini guna. Pengguna mesti masuk melalui app (anonymous sign-in).
    match /orders/{id} { allow read, write: if request.auth != null; }
    match /boards/{id} { allow read, write: if request.auth != null; }
    match /config/{id} { allow read, write: if request.auth != null; }
  }
}
